# Public values only: Vite embeds VITE_* variables in the browser bundle.
# Empty URL uses the same origin as Nginx.
VITE_API_URL=
VITE_CULQI_PUBLIC_KEY=
# CulqiPanel: ID/hash RSA and PUBLIC key (never the private key).
VITE_CULQI_RSA_ID=
# Quote the complete PEM; use literal \n between its lines.
VITE_CULQI_RSA_PUBLIC_KEY=
