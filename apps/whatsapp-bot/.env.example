# Copy values into .env only as needed; do not overwrite your existing .env.
API_URL=http://localhost:3000
# BACKEND_URL is supported as a legacy fallback. API_URL takes precedence.
WA_AUTH_PATH=.wwebjs_auth
WA_HEADLESS=true
WA_DIAGNOSTIC=false
WA_STARTUP_TIMEOUT_MS=300000
WA_READY_TIMEOUT_MS=120000
# Only enable if the deployment cannot run Chromium with its sandbox.
WA_NO_SANDBOX=false
# Optional: use an existing compatible Chrome installation.
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
