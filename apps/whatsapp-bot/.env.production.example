NODE_ENV=production
API_URL=http://api:3000
WA_SERVICE_TOKEN=GENERATE_RANDOM_SECRET
LOCAL_LINK=http://localhost:8080/checkout
WA_AUTH_PATH=/data/whatsapp
WA_HEADLESS=true
# Chromium exception for the Docker container, without privileged mode.
WA_NO_SANDBOX=true
WA_DIAGNOSTIC=true
WA_STARTUP_TIMEOUT_MS=600000
WA_READY_TIMEOUT_MS=120000
