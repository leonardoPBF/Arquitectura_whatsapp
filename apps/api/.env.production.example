NODE_ENV=production
# Internal port used by Nginx and healthchecks; keep 3000.
PORT=3000
MONGO_URI=mongodb://mongo:27017/lumina
JWT_SECRET=GENERATE_RANDOM_SECRET
RASA_ACTIONS_TOKEN=GENERATE_RANDOM_SECRET
WA_SERVICE_TOKEN=GENERATE_RANDOM_SECRET
RASA_URL=http://rasa:5005
LOCAL_LINK=http://localhost:8080/checkout
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# Optional: configure actual provider credentials before using these integrations.
CULQI_PRIVATE_KEY=
CULQI_PUBLIC_KEY=
CULQI_SECRET=
GOOGLE_SHEET_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google.json
