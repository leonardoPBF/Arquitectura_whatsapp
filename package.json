{
  "name": "arquitectura_whatsapp",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "eslint/base.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --max-warnings 150",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky install",
    "format:write": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "build:docs": "npm run build --workspace=docs",
    "build:backend": "npm run build --workspace=api",
    "build:frontend": "cd apps/frontend && npm run build",
    "dev:docs": "npm run dev --workspace=docs",
    "dev:backend": "npm run dev --workspace=api",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build:all": "npm run build --workspaces --if-present",
    "preview:docs": "npm run preview --workspace=docs",
    "preview:backend": "npm run preview --workspace=backend",
    "preview:frontend": "cd apps/frontend && npm run preview",
    "preview:all": "concurrently -n preview:docs,preview:backend,preview:frontend",
    "run:all": "concurrently -n dev:api,dev:frontend,dev:whatsapp -c blue,green,yellow \"npm run dev:api\" \"npm run dev:frontend\" \"npm run prod:whatsapp\"",
    "build:api": "npm run build --workspace=api",
    "build:whatsapp": "npm run build --workspace=whatsapp-bot",
    "dev:api": "npm run dev --workspace=api",
    "prod:whatsapp": "npm run prod --workspace=whatsapp-bot",
    "diagnose:whatsapp": "npm run diagnose --workspace=whatsapp-bot",
    "doctor:whatsapp": "npm run doctor --workspace=whatsapp-bot",
    "test:whatsapp": "npm test --workspace=whatsapp-bot",
    "docker:setup": "node scripts/docker-setup.cjs",
    "docker:build": "docker compose --env-file .env.production build",
    "docker:up": "docker compose --env-file .env.production up -d --build",
    "docker:down": "docker compose --env-file .env.production down",
    "docker:logs": "docker compose --env-file .env.production logs -f --tail=100",
    "docker:validate": "node scripts/docker-setup.cjs && node scripts/docker-env-check.cjs",
    "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "npm run lint:fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@commitlint/config-conventional": "^20.0.0",
    "commitlint": "^20.1.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardoPBF/Arquitectura_whatsapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/leonardoPBF/Arquitectura_whatsapp/issues"
  },
  "homepage": "https://github.com/leonardoPBF/Arquitectura_whatsapp#readme"
}
